<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimpleCalculatorMauiApp.MainPage"
             Title="Kalkulator"
             Background="Lime">

    <ScrollView>
        <StackLayout Orientation="Vertical" Spacing="20" Margin="10">
            <Label Text="Podaj pierwszą liczbę:"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <Entry FontSize="20"
                   x:Name="firstNumberEntry"/>

            <Label Text="Podaj drugą liczbę:"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <Entry FontSize="20"
                   x:Name="secondNumberEntry"/>

            <Button Text="Oblicz"
                    BackgroundColor="black"
                    TextColor="White"
                    FontSize="20" 
                    Clicked="Button_Clicked"/>

            <Label x:Name="resultLabel"
                   FontSize="20"/>
        </StackLayout>
    </ScrollView>

</ContentPage>
